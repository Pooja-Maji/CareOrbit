{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RuleSchema",
  "type": "object",
  "required": ["id", "version", "source"],
  "properties": {
    "id": { "type": "string" },
    "version": { "type": "string" },
    "title": { "type": "string" },
    "source": { "type": "string" },
    "threshold": { "type": "number" },
    "clinical_review_status": { "type": "string" }
  }
}
